+#[test]
+fn fold_targets_the_named_task_not_the_last_set_tag() {
+    let mut app = build_fold_app();
+    // A second, newer tag (nested): folding the OUTER one must splice at the
+    // outer call even though a different set_tag call is more recent.
+    app.state.session.messages(); // touch
+    let mut messages = app.state.session.messages().to_vec();
+    messages.insert(
+        2,
+        Message {
+            role: Role::Assistant,
+            content: vec![ContentBlock::tool_use(
+                "tag-0",
+                "set_tag",
+                serde_json::json!({"task": "outer"}),
+            )],
+            ..Default::default()
+        },
+    );
+    messages.insert(
+        3,
+        Message {
+            role: Role::User,
+            content: vec![ContentBlock::ToolResult {
+                tool_use_id: "tag-0".into(),
+                content: "Tag set".into(),
+                is_error: false,
+            }],
+            ..Default::default()
+        },
+    );
+    app.state.session_mut().replace_messages(messages);
+
+    let (actions, _) = match app.fold_tag("set_tag", "outer", "outer summary") {
+        Ok(result) => result,
+        Err(e) => panic!("fold failed: {e}"),
+    };
+    let msgs = app.state.session.messages();
+    assert_eq!(msgs.len(), 4); // prompt, outer tag call, outer result, receipt
+    let Action::LoadSession(loaded) = &actions[0] else {
+        panic!("expected LoadSession");
+    };
+    assert_eq!(loaded.messages.len(), 4);
+}

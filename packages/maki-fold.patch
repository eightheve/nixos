+
+    fn fold_gate(&self) -> Result<(), String> {
+        if self.awaiting_input() {
+            return Err("session is waiting for input".into());
+        }
+        if self.status == Status::Streaming {
+            return Err("session is streaming; retry when idle".into());
+        }

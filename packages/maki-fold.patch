+/// Unconditionally archives the session's current log, returning the archive
+/// sequence. Restore-style surgery swaps in a history that is not a prefix of
+/// the current one, so what it replaces is a branch, not a shrink: without
+/// this the replaced tail would leave no archive to ever return to.
+pub fn force_archive<M, U, T>(
+    dir: &Path,
+    session: &Session<M, U, T>,
+) -> Result<u64, StorageError> {
+    let path = jsonl_path(dir, session.id);
+    let archive_dir = dir.join(ARCHIVE_DIR).join(session.id.to_string());
+    fs::create_dir_all(&archive_dir)?;
+    let existing = archives_newest_first(&archive_dir);
+    let next = existing.first().map_or(0, |a| a.seq) + 1;
+    let archive_path = archive_dir.join(format!("{next}.jsonl"));
+    let bytes = link_archive(&path, &archive_path)?;
+    prune_archives(existing, bytes);
+    crate::sync_parent_dir(&archive_path);
+    info!(
+        session_id = %session.id,
+        archive = %archive_path.display(),
+        "archived session log before restore rewrite"
+    );
+    Ok(next)
+}

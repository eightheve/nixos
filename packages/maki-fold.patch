+    /// Folds the conversation back to the tag call: the call keeps its place,
+    /// its result becomes {receipt}, and everything after it leaves the
+    /// context. Sibling tool results in the tag's result message ride along,
+    /// so the assistant message stays API-valid.
+    pub(crate) fn fold_tag(
+        &mut self,
+        tool_name: &str,
+        task: &str,
+        receipt: &str,
+    ) -> Result<(Vec<Action>, Option<u64>), String> {
+        self.fold_gate()?;
+        let messages = self.state.session.messages().to_vec();
+        let Some((ai, tag_id)) = Self::last_tag_call(&messages, tool_name, task) else {
+            return Err(format!("no {tool_name} call found for task \"{task}\""));
+        };
+
+        let mut sibling_ids: Vec<String> = messages[ai]
+            .content
+            .iter()
+            .filter_map(|b| match b {
+                ContentBlock::ToolUse { id, .. } if *id != tag_id => Some(id.clone()),
+                _ => None,
+            })
+            .collect();
+        let mut tag_result_found = false;
+        let mut carried: Vec<ContentBlock> = Vec::new();
+        for m in messages.iter().skip(ai + 1) {
+            if !matches!(m.role, Role::User) {
+                break;
+            }
+            for block in &m.content {
+                if let ContentBlock::ToolResult {
+                    tool_use_id,
+                    content: _,
+                    is_error: _,
+                } = block
+                {
+                    if *tool_use_id == tag_id {
+                        tag_result_found = true;
+                    } else if let Some(pos) =

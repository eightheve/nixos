+#[test]
+fn restore_returns_archived_tangent_and_undoes_the_fold() {
+    let mut app = build_fold_app();
+    // Park the pre-fold transcript as fold archive 1, the way the writer
+    // would have when the fold committed.
+    let sessions_dir = app.storage.ensure_subdir(maki_storage::sessions::SESSIONS_DIR).unwrap();
+    Arc::make_mut(&mut app.state.session)
+        .save_to(&sessions_dir)
+        .unwrap();
+    let archive_dir = sessions_dir
+        .join(maki_storage::sessions::ARCHIVE_DIR)
+        .join(app.state.session.id.to_string());
+    fs::create_dir_all(&archive_dir).unwrap();
+    fs::hard_link(
+        sessions_dir.join(app.state.session.id.to_string()).with_extension("jsonl"),
+        archive_dir.join("1.jsonl"),
+    )
+    .unwrap();
+
+    match app.fold_tag("set_tag", "research", "findings: X uses Y") {
+        Ok(_) => {}
+        Err(e) => panic!("pre-fold failed: {e}"),
+    }
+    assert_eq!(app.state.session.messages().len(), 3);
+
+    let (actions, replaced) = match app.restore_tag(Some(1), "set_tag", "research", "fold") {
+        Ok(result) => result,
+        Err(e) => panic!("restore failed: {e}"),
+    };
+    let msgs = app.state.session.messages();
+    assert_eq!(msgs.len(), 8);
+    let last = &msgs[7];
+    let ContentBlock::ToolResult { tool_use_id, content, .. } = &last.content[0] else {
+        panic!("expected the fold result");
+    };
+    assert_eq!(tool_use_id.as_str(), "fold-1");
+    assert!(content.contains("[fold undone]"));
+    assert!(!content.contains("queued"));
+    let stored = app.state.session.tool_outputs().get("fold-1").unwrap();
+    assert!(stored.as_text().contains("[fold undone]"));
+
+    let Action::LoadSession(loaded) = &actions[0] else {
+        panic!("expected LoadSession");
+    };
+    assert_eq!(loaded.messages.len(), 8);
+    // The replaced branch got its own archive.
+    assert_eq!(replaced, Some(2));
+    assert!(archive_dir.join("2.jsonl").exists());
+}
+
+/// Regression: the in-surgery checkpoint applied the agent's stale pre-fold
+/// mirror over the fold. rewind_to dodges this by never checkpointing.
+#[test]
+fn fold_survives_a_stale_agent_mirror() {
+    let mut app = build_fold_app();
+    let pre_fold = app.state.session.messages().to_vec();
+    app.shared_history = Some(Arc::new(ArcSwap::from_pointee(
+        maki_storage::sessions::HistorySnapshot::new(pre_fold),
+    )));
+
+    app.fold_tag("set_tag", "research", "findings: X uses Y").unwrap();
+
+    let msgs = app.state.session.messages();
+    assert_eq!(msgs.len(), 3, "the stale mirror must not restore the tangent");
+    let last = &msgs[2];
+    assert!(last.is_observation(), "receipt must survive the checkpoint path");
+    // The mirror is gone, so the next frame's checkpoint persists the fold.
+    assert!(app.shared_history.is_none());
+}

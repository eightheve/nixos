+    /// Restores a folded transcript, with the fold call's result replaced by
+    /// an undo notice.
+    pub(crate) fn restore_tag(
+        &mut self,
+        archive_seq: Option<u64>,
+        tool_name: &str,
+        task: &str,
+        fold_tool_name: &str,
+    ) -> Result<(Vec<Action>, Option<u64>), String> {
+        self.fold_gate()?;
+        let path = self.locate_archive(archive_seq, tool_name, task)?;
+        let archived = load_session_at::<Message, TokenUsage, ToolOutput>(&path)
+            .map_err(|e| format!("fold archive unreadable: {e}"))?;
+        let archived_messages = archived.messages().to_vec();
+        let Some((ai, _)) = Self::last_tag_call(&archived_messages, tool_name, task) else {
+            return Err(format!("no {tool_name} call for task \"{task}\" in the fold archive"));
+        };
+        let Some((fi, fold_id)) = Self::last_tag_call(&archived_messages, fold_tool_name, "")
+        else {
+            return Err(format!("no {fold_tool_name} call in the fold archive"));
+        };
+        if fi <= ai {
+            return Err("the fold archive does not contain this tag's fold".into());
+        }
+
+        let mut restored = archived_messages;
+        let mut undone = false;
+        for m in restored[fi + 1..].iter_mut() {
+            if !matches!(m.role, Role::User) {
+                break;
+            }
+            for b in m.content.iter_mut() {
+                if let ContentBlock::ToolResult { tool_use_id, content, .. } = b
+                    && tool_use_id == &fold_id
+                {
+                    *content = Self::UNDO_NOTICE.into();
+                    undone = true;
+                }
+            }
+            if undone {
+                break;
+            }
+        }
+        if !undone {
+            return Err("the archived fold call has no result to undo".into());
+        }
+
+        let baseline = self
+            .state
+            .context_size
+            .saturating_sub(estimate_message_tokens(self.state.session.messages()));
+        let kept = estimate_message_tokens(&restored);
+        self.state.context_size = if kept == 0 { 0 } else { baseline + kept };
+
+        // What the restore replaces is a branch, not a shrink: archive it
+        // first or it is gone.
+        let sessions_dir = self
+            .storage
+            .ensure_subdir(SESSIONS_DIR)
+            .map_err(|e| e.to_string())?;
+        let replaced = force_archive(&sessions_dir, self.state.session.as_ref())
+            .map_err(|e| format!("could not archive the replaced transcript: {e}"))?
+            .to_string();
+
+        {
+            let session = self.state.session_mut();
+            session.replace_messages(restored);
+            for (id, output) in archived.tool_outputs() {
+                session.insert_tool_output(id.clone(), Arc::clone(output));
+            }
+            session.insert_tool_output(
+                fold_id,
+                Arc::new(ToolOutput::Plain(Self::UNDO_NOTICE.into())),
+            );
+            session.prune_orphans(|m| m.tool_uses().map(|(id, _, _)| id.to_owned()).collect());
+        }

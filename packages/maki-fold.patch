+#[test]
+fn fold_refuses_a_tag_without_a_result() {
+    let mut app = build_fold_app();
+    // Drop everything after the tag call: no result, nothing to fold yet.
+    app.state.session_mut().truncate_messages(2);
+    let err = match app.fold_tag("set_tag", "research", "findings") {
+        Err(e) => e,
+        Ok(_) => panic!("expected the fold to be refused"),
+    };
+    assert!(err.contains("no result yet"), "got: {err}");
+}

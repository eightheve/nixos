+        panic!("expected the tag tool_use to survive");
+    };
+    assert_eq!((id.as_str(), name.as_str()), ("tag-1", "set_tag"));
+    assert_eq!(input.get("task").and_then(|t| t.as_str()), Some("research"));
+    let receipt = &msgs[2];
+    assert!(receipt.is_observation());
+    assert!(matches!(receipt.role, Role::User));
+    let ContentBlock::ToolResult { tool_use_id, content, .. } = &receipt.content[0] else {
+        panic!("expected a tool result receipt");
+    };
+    assert_eq!(tool_use_id.as_str(), "tag-1");
+    assert!(content.contains("TAG FOLD COMPLETE"));
+    assert!(content.contains("Folded away: 6"));
+    assert!(content.contains("3 user message(s)"));
+    assert!(content.contains("findings: X uses Y"));
+    let stored = app.state.session.tool_outputs().get("tag-1").unwrap();
+    assert!(stored.as_text().contains("TAG FOLD COMPLETE"));
+
+    let Action::LoadSession(loaded) = &actions[0] else {
+        panic!("expected LoadSession");
+    };
+    assert_eq!(loaded.messages.len(), 3);
+    assert_eq!(archived, Some(1));
+}

+    /// The archive sequence the next shrink-rewrite will pick.
+    pub(crate) fn next_archive_seq(&self) -> u64 {
+        let Ok(sessions_dir) = self.storage.ensure_subdir(SESSIONS_DIR) else {
+            return 0;

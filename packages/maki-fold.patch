+    /// The archive for a restore: {seq} if given, else a newest-first scan.
+    fn locate_archive(
+        &self,
+        seq: Option<u64>,
+        tool_name: &str,
+        task: &str,
+    ) -> Result<PathBuf, String> {
+        let sessions_dir = self
+            .storage
+            .ensure_subdir(SESSIONS_DIR)
+            .map_err(|e| e.to_string())?;
+        let archive_dir = sessions_dir
+            .join(ARCHIVE_DIR)
+            .join(self.state.session.id.to_string());
+        if let Some(seq) = seq {
+            let path = archive_dir.join(format!("{seq}.jsonl"));
+            if path.exists() {
+                return Ok(path);
+            }
+        }
+        for archive in archives_newest_first(&archive_dir) {
+            if let Ok(session) =

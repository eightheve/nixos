+/// Where a raw kept tail may start: a transcript may resume at a user message
+/// carrying no tool results. Tool results must follow their calls, and an
+/// assistant message cannot open a transcript.
+fn is_safe_cut_start(message: &Message) -> bool {
+    matches!(message.role, Role::User)
+        && !message
+            .content
+            .iter()
+            .any(|block| matches!(block, ContentBlock::ToolResult { .. }))
+}
+
+/// The index a kept raw tail starts at: the newest contiguous run of
+/// answered messages whose estimate fits [`KEEP_RECENT_TOKEN_BUDGET`], cut at
+/// the nearest legal start. A history the budget never cuts keeps nothing —
+/// everything is summarized, as before the tail existed.
+fn keep_recent_from(messages: &[Message], end: usize, floor: usize) -> usize {
+    if end <= floor {
+        return floor;
+    }
+    let mut accumulated: u32 = 0;
+    let mut start = end;
+    let mut budget_cut = false;
+    for index in (floor..end).rev() {
+        let tokens = estimate_message_tokens(std::slice::from_ref(&messages[index]));
+        if accumulated.saturating_add(tokens) > KEEP_RECENT_TOKEN_BUDGET {
+            budget_cut = true;
+            break;
+        }
+        accumulated += tokens;
+        start = index;
+    }
+    if !budget_cut {
+        return floor;
+    }
+    while start < end && !is_safe_cut_start(&messages[start]) {
+        start += 1;
+    }
+    if start >= end || start <= floor {
+        return floor;
+    }
+    start
+}

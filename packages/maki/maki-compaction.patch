+/// `(summarize start, previous summary)` for the range to summarize. An
+/// already-compacted session carries the summary pair at `[0..2]`; that pair
+/// is replaced by the updated summary rather than re-summarized, and the old
+/// summary text rides in the prompt so the model merges instead of
+/// regenerating.
+fn previous_summary_range(history: &[Message], summarized: usize) -> (usize, Option<&str>) {
+    let marker_pair = history.len() >= 2
+        && summarized >= 2
+        && history[0].user_text() == Some(SUMMARY_MARKER)
+        && matches!(history[1].role, Role::Assistant)
+        && history[1].first_text_content().is_some();
+    if marker_pair {
+        (2, history[1].first_text_content())
+    } else {
+        (0, None)
+    }
+}

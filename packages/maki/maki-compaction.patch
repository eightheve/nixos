+const FILE_INVENTORY_TOOLS_READ: &[&str] = &["read"];
+const FILE_INVENTORY_TOOLS_MODIFIED: &[&str] = &["write", "edit"];
+
+/// Deterministic read/modified file lists extracted from the summarized
+/// range's own tool calls. Appended to the summary verbatim, they survive no
+/// matter what the summariser model chooses to mention.
+fn file_inventory(messages: &[Message]) -> Option<String> {
+    let mut read: Vec<&str> = Vec::new();
+    let mut modified: Vec<&str> = Vec::new();
+    let mut seen: HashSet<&str> = HashSet::new();
+    for msg in messages {
+        if !matches!(msg.role, Role::Assistant) {
+            continue;
+        }
+        for (_, name, input) in msg.tool_uses() {
+            let Some(path) = input.get("path").and_then(Value::as_str) else {
+                continue;
+            };
+            if !seen.insert(path) {
+                continue;
+            }
+            if FILE_INVENTORY_TOOLS_READ.contains(&name) {
+                read.push(path);
+            } else if FILE_INVENTORY_TOOLS_MODIFIED.contains(&name) {
+                modified.push(path);
+            }
+        }
+    }
+    if read.is_empty() && modified.is_empty() {
+        return None;
+    }
+    let mut sections: Vec<String> = Vec::new();
+    if !read.is_empty() {
+        sections.push(format!("<read-files>\n{}\n</read-files>", read.join("\n")));
+    }
+    if !modified.is_empty() {
+        sections.push(format!(
+            "<modified-files>\n{}\n</modified-files>",
+            modified.join("\n")
+        ));
+    }
+    Some(format!("\n\n{}", sections.join("\n\n")))
+}
